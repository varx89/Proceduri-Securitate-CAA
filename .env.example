# Copiază în .env.local (local) sau pune-le în Coolify → Environment Variables

# JWT (un șir lung și aleator)
JWT_SECRET=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=proceduri
DB_USER=
DB_PASSWORD=

# Calea secretă pentru înregistrare: https://domeniu/<REGISTER_SLUG>
# Gol = înregistrarea e dezactivată
REGISTER_SLUG=

# Cookie-urile sunt "secure" (doar HTTPS) în producție. Pune false doar dacă rulezi pe HTTP simplu.
SECURE_LOGIN=true

# Folderul pentru PDF-uri (în Docker: /app/uploads, montat ca volum persistent)
# UPLOAD_DIR=./uploads
